# AutoHelper Environment Configuration
# Copy this file to .env and fill in values.

# Server
AUTOHELPER_HOST=127.0.0.1
AUTOHELPER_PORT=8100
AUTOHELPER_LOG_LEVEL=INFO

# Contact Sync (Exchange Online)
# AUTOHELPER_CONTACT_SYNC_ENABLED=true
# AUTOHELPER_CONTACT_SYNC_CSV_PATH=C:\path\to\master_contacts.csv
# AUTOHELPER_CONTACT_SYNC_EXCHANGE_UPN=admin@ballardfineart.com
# AUTOHELPER_CONTACT_SYNC_EXCHANGE_ORG=ballardfineart.com
# AUTOHELPER_CONTACT_SYNC_EXCHANGE_APP_ID=
# AUTOHELPER_CONTACT_SYNC_EXCHANGE_CERT_THUMBPRINT=

# Mail Polling
# AUTOHELPER_MAIL_ENABLED=true
# AUTOHELPER_MAIL_POLL_INTERVAL=30
